Ôr@Ÿªassertions¤code´customTransformCache¬dependencies¢id¤meta±moduleSideEffects¬originalCode±originalSourcemap«resolvedIds®sourcemapChainµsyntheticNamedExportsµtransformDependencies®transformFiles¨cacheAstÔrAÚ0import { globalData } from '../model/LearningData';
import { Course } from '../model/CourseModel';
import { LearningMaterial, MaterialType, MaterialSource } from '../model/MaterialModel';
export class StorageUtil {
    static saveData() {
        try {
            const json = globalData.toJSON();
            AppStorage.set(StorageUtil.KEY_LEARNING_DATA, json);
        }
        catch (e) {
            console.error('Save data failed: ' + JSON.stringify(e));
        }
    }
    static loadData() {
        try {
            const json = AppStorage.get(StorageUtil.KEY_LEARNING_DATA);
            if (json && json.length > 0) {
                const parsed = JSON.parse(json);
                if (parsed.courses) {
                    const coursesArr = parsed.courses;
                    for (let i = 0; i < coursesArr.length; i++) {
                        const c = coursesArr[i];
                        const id = c['id'];
                        const existing = globalData.getCourse(id);
                        if (!existing) {
                            const course = new Course();
                            course.id = c['id'];
                            course.title = c['title'];
                            course.description = c['description'];
                            const statusStr = c['status'];
                            course.status = (statusStr === 'completed') ? 'completed' : 'active';
                            course.progress = c['progress'];
                            course.createdAt = c['createdAt'];
                            course.q1Completed = c['q1Completed'];
                            course.q2Completed = c['q2Completed'];
                            course.q3Completed = c['q3Completed'];
                            course.q3Accuracy = c['q3Accuracy'] ?? 0;
                            course.lastAccessedAt = c['lastAccessedAt'] ?? 0;
                            globalData.addCourse(course);
                        }
                    }
                }
                if (parsed.achievements) {
                    const achObj = parsed.achievements;
                    const achKeys = Object.keys(achObj);
                    for (let i = 0; i < achKeys.length; i++) {
                        const achId = achKeys[i];
                        globalData.setAchievementEarned(achId, achObj[achId]);
                    }
                }
                if (parsed.studyStreak !== undefined) {
                    globalData.setStreakData(parsed.studyStreak, parsed.lastStudyDate ?? 0);
                }
                if (parsed.courseMaterials) {
                    const materialsObj = parsed.courseMaterials;
                    const courseIds = [];
                    const matKeys = Object.keys(materialsObj);
                    for (let i = 0; i < matKeys.length; i++) {
                        courseIds.push(matKeys[i]);
                    }
                    for (let j = 0; j < courseIds.length; j++) {
                        const courseId = courseIds[j];
                        const mats = materialsObj[courseId];
                        const materials = [];
                        for (let k = 0; k < mats.length; k++) {
                            const m = mats[k];
                            const lm = new LearningMaterial();
                            lm.id = m['id'];
                            lm.title = m['title'];
                            const typeStr = m['type'];
                            lm.type = typeStr === 'pdf' ? MaterialType.PDF :
                                typeStr === 'word' ? MaterialType.WORD :
                                    typeStr === 'markdown' ? MaterialType.MARKDOWN :
                                        typeStr === 'web' ? MaterialType.WEB :
                                            MaterialType.AI_GENERATED;
                            const sourceStr = m['source'];
                            lm.source = sourceStr === 'user_upload' ? MaterialSource.USER_UPLOAD :
                                sourceStr === 'ai_supplement' ? MaterialSource.AI_SUPPLEMENT :
                                    MaterialSource.WEB_SEARCH;
                            lm.content = m['content'] || '';
                            lm.summary = m['summary'] || '';
                            lm.keywords = m['keywords'] || [];
                            lm.courseId = m['courseId'] || '';
                            lm.modulePath = m['modulePath'] || '';
                            lm.url = m['url'] || '';
                            lm.filePath = m['filePath'] || '';
                            lm.fileSize = m['fileSize'] || 0;
                            lm.createdAt = m['createdAt'] || 0;
                            lm.updatedAt = m['updatedAt'] || 0;
                            lm.isRead = m['isRead'] || false;
                            lm.readProgress = m['readProgress'] || 0;
                            lm.rating = m['rating'] || 0;
                            lm.tags = m['tags'] || [];
                            materials.push(lm);
                        }
                        globalData.setMaterials(courseId, materials);
                    }
                }
                if (parsed.studySessions) {
                    const sessionsArr = parsed.studySessions;
                    for (let i = 0; i < sessionsArr.length; i++) {
                        const s = sessionsArr[i];
                        const session = {
                            date: s['date'],
                            minutes: s['minutes'],
                            courseId: s['courseId']
                        };
                        globalData.restoreSession(session.date, session.minutes, session.courseId);
                    }
                }
                if (parsed.notes) {
                    const notesObj = parsed.notes;
                    const noteKeys = Object.keys(notesObj);
                    for (let i = 0; i < noteKeys.length; i++) {
                        globalData.setNotes(noteKeys[i], notesObj[noteKeys[i]]);
                    }
                }
                if (parsed.reviewQueue) {
                    const reviewArr = parsed.reviewQueue;
                    for (let i = 0; i < reviewArr.length; i++) {
                        const r = reviewArr[i];
                        const item = {
                            questionId: r['questionId'],
                            courseId: r['courseId'],
                            questionText: r['questionText'],
                            options: r['options'],
                            correctIndex: r['correctIndex'],
                            userAnswer: r['userAnswer'],
                            lastReviewDate: r['lastReviewDate'],
                            nextReviewDate: r['nextReviewDate'],
                            interval: r['interval'],
                            reviewCount: r['reviewCount']
                        };
                        globalData.addReviewItem(item);
                    }
                }
            }
        }
        catch (e) {
            console.error('Load data failed: ' + JSON.stringify(e));
        }
    }
}
StorageUtil.KEY_LEARNING_DATA = 'threeq_learning_data';
