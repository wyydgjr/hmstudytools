        Blank()
        Text(globalData.getStreak() + ' å¤©')
          .fontSize(14).fontWeight(FontWeight.Bold)
          .fontColor(Constants.COLOR_ACCENT_ORANGE)
      }
      .width('100%')
      .margin({ top: 4 })

      Text('ç•ªèŒ„å·¥ä½œæ³•ï¼šä¸“æ³¨25åˆ†é’Ÿ + ä¼‘æ¯5åˆ†é’Ÿï¼Œæ¯4ä¸ªå¾ªçŽ¯åŽé•¿ä¼‘æ¯15-30åˆ†é’Ÿ')
        .fontSize(11).fontColor(Constants.COLOR_TEXT_SECONDARY).margin({ top: 12 })
        .lineHeight(16)
    }
    .width('100%')
    .padding(16)
    .backgroundColor(Constants.COLOR_CARD)
    .borderRadius(16)
    .margin({ top: 12, bottom: 20 })
  }

  startTimer(): void {
    this.isActive = true;
    this.timerId = setInterval(() => {
      if (this.secondsLeft <= 1) {
        this.completeTimer();
      } else {
        this.secondsLeft--;
      }
    }, 1000);
  }

  pauseTimer(): void {
    this.isActive = false;
    if (this.timerId > 0) {
      clearInterval(this.timerId);
      this.timerId = -1;
    }
  }

  stopTimer(): void {
    this.isActive = false;
    if (this.timerId > 0) {
      clearInterval(this.timerId);
      this.timerId = -1;
    }
  }

  completeTimer(): void {
    this.stopTimer();
    if (!this.isBreak) {
      this.sessionCount++;
      const now = new Date();
      const dateStr = now.getFullYear() + '-' +
        String(now.getMonth() + 1).padStart(2, '0') + '-' +
        String(now.getDate()).padStart(2, '0');
      const lastCourse = globalData.getLastActiveCourse();
      globalData.addStudySession(dateStr, this.focusMinutes, lastCourse ? lastCourse.id : '');
      StorageUtil.saveData();
      this.todayFocus = globalData.getTodayFocusMinutes();

      AlertDialog.show({
        title: 'ðŸŽ‰ ä¸“æ³¨å®Œæˆï¼',
        message: 'å·²å®Œæˆ ' + this.focusMinutes + ' åˆ†é’Ÿä¸“æ³¨å­¦ä¹ \nä¼‘æ¯ä¸€ä¸‹å§ï½ž',
        confirm: { value: 'å¼€å§‹ä¼‘æ¯', action: () => {
          this.isBreak = true;
          this.secondsLeft = this.breakMinutes * 60;
          this.startTimer();
        }}
      });
    } else {
      AlertDialog.show({
        title: 'â˜• ä¼‘æ¯ç»“æŸ',
        message: 'ä¼‘æ¯å¥½äº†å—ï¼Ÿå‡†å¤‡å¼€å§‹ä¸‹ä¸€è½®ä¸“æ³¨ï¼',
        confirm: { value: 'å¼€å§‹ä¸“æ³¨', action: () => {
          this.isBreak = false;
          this.resetTimer();
        }}
      });
    }
  }

  resetTimer(): void {
    this.isBreak = false;
    this.secondsLeft = this.selectedMinutes * 60;
  }

  formatTime(seconds: number): string {
    const m = Math.floor(seconds / 60);
    const s = seconds % 60;
    return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
  }

  getWeekFocusMinutes(): number {
    const sessions = globalData.getStudySessions();
    const now = new Date();
    const weekAgo = now.getTime() - 7 * 24 * 60 * 60 * 1000;
    let total = 0;
    for (let i = 0; i < sessions.length; i++) {
      const parts = sessions[i].date.split('-');
      const sessionTime = new Date(
        parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2])
      ).getTime();
      if (sessionTime >= weekAgo) {
        total += sessions[i].minutes;
      }
    }
    return total;
  }
}
