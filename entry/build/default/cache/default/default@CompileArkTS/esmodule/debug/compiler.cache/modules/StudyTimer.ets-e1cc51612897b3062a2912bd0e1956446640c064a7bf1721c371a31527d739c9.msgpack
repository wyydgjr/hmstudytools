  @State todayFocus: number = 0;
  @State selectedMinutes: number = 25;
  @State showPreset: boolean = false;
  private timerId: number = -1;

  aboutToAppear(): void {
    this.todayFocus = globalData.getTodayFocusMinutes();
    this.resetTimer();
  }

  aboutToDisappear(): void {
    this.stopTimer();
  }

  build() {
