export class LearningMaterial {
    constructor() {
        this.id = '';
        this.title = '';
        this.type = MaterialType.PDF;
        this.source = MaterialSource.USER_UPLOAD;
        this.content = '';
        this.summary = '';
        this.keywords = [];
        this.courseId = '';
        this.modulePath = ''; // å…³è”çš„è¯¾ç¨‹æ¨¡å—è·¯å¾„
        this.url = ''; // åŸå§‹URLï¼ˆå¦‚æœæ˜¯ç½‘é¡µï¼‰
        this.filePath = ''; // æœ¬åœ°æ–‡ä»¶è·¯å¾„
        this.fileSize = 0;
        this.createdAt = 0;
        this.updatedAt = 0;
        this.isRead = false;
        this.readProgress = 0;
        this.rating = 0; // ç”¨æˆ·è¯„åˆ† 1-5
        this.tags = [];
    }
    static generateId() {
        return 'mat_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
    }
    static createFromUpload(title, type, content, courseId) {
        const material = new LearningMaterial();
        material.id = LearningMaterial.generateId();
        material.title = title;
        material.type = type;
        material.source = MaterialSource.USER_UPLOAD;
        material.content = content;
        material.courseId = courseId;
        material.createdAt = Date.now();
        material.updatedAt = Date.now();
        return material;
    }
    static createFromAI(title, content, courseId, keywords = []) {
        const material = new LearningMaterial();
        material.id = LearningMaterial.generateId();
        material.title = title;
        material.type = MaterialType.AI_GENERATED;
        material.source = MaterialSource.AI_SUPPLEMENT;
        material.content = content;
        material.courseId = courseId;
        material.keywords = keywords;
        material.createdAt = Date.now();
        material.updatedAt = Date.now();
        return material;
    }
    static createFromWeb(title, url, content, courseId) {
        const material = new LearningMaterial();
        material.id = LearningMaterial.generateId();
        material.title = title;
        material.type = MaterialType.WEB;
        material.source = MaterialSource.WEB_SEARCH;
        material.url = url;
        material.content = content;
        material.courseId = courseId;
        material.createdAt = Date.now();
        material.updatedAt = Date.now();
        return material;
    }
}
// çŸ¥è¯†åº“æ¨¡å—
export class KnowledgeModule {
    constructor() {
        this.id = '';
        this.name = '';
        this.description = '';
        this.courseId = '';
        this.materials = [];
        this.parentModuleId = '';
        this.childModules = [];
        this.keywords = [];
        this.createdAt = 0;
    }
    static generateId() {
        return 'mod_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
    }
    static create(name, description, courseId, parentId = '') {
        const module = new KnowledgeModule();
        module.id = KnowledgeModule.generateId();
        module.name = name;
        module.description = description;
        module.courseId = courseId;
        module.parentModuleId = parentId;
        module.createdAt = Date.now();
        return module;
    }
    addMaterial(material) {
        material.modulePath = this.id;
        this.materials.push(material);
    }
    removeMaterial(materialId) {
        this.materials = this.materials.filter(m => m.id !== materialId);
    }
    getMaterialCount() {
        return this.materials.length;
    }
    getTotalSize() {
        return this.materials.reduce((sum, m) => sum + m.fileSize, 0);
    }
}
