              .onClick(() => {
                this.inputText = q;
                this.sendMessage();
              })
          }, (q: string) => q)
        }
        .padding({ left: 4, right: 4 })
      }
      .width('100%')
      .scrollable(ScrollDirection.Horizontal)
      .height(40)
      .scrollBar(BarState.Off)

      // è¾“å…¥æ¡†
      Row() {
        TextArea({ placeholder: 'è¾“å…¥ä½ çš„é—®é¢˜...', text: this.inputText })
          .layoutWeight(1)
          .height(44)
          .backgroundColor('#FFFFFF')
          .borderRadius(22)
          .placeholderColor(Constants.COLOR_TEXT_SECONDARY)
          .onChange((val: string) => {
            this.inputText = val;
          })
          .onSubmit(() => {
            this.sendMessage();
          })

        Stack() {
          Circle()
            .width(44)
            .height(44)
            .fill(this.inputText.length > 0 ? Constants.COLOR_PRIMARY : 0x20000000)
          Text('å‘é€')
            .fontSize(12)
            .fontColor(this.inputText.length > 0 ? '#FFFFFF' : Constants.COLOR_TEXT_SECONDARY)
            .fontWeight(FontWeight.Bold)
        }
        .width(44)
        .height(44)
        .margin({ left: 8 })
        .onClick(() => {
          if (this.inputText.length > 0) {
            this.sendMessage();
          }
