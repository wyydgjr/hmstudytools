  getQuickQuestions(): string[] {
    return [
      'æ ¸å¿ƒæ¦‚å¿µæ˜¯ä»€ä¹ˆï¼Ÿ',
      'å¦‚ä½•å¿«é€Ÿå…¥é—¨ï¼Ÿ',
      'æœ‰å“ªäº›æœ€ä½³å®è·µï¼Ÿ',
      'å¸¸è§é—®é¢˜æœ‰å“ªäº›ï¼Ÿ',
      'æ¨èå­¦ä¹ è·¯å¾„ï¼Ÿ',
      'å®é™…åº”ç”¨æ¡ˆä¾‹ï¼Ÿ'
    ];
  }

  formatTime(timestamp: number): string {
    const date = new Date(timestamp);
    const hours = date.getHours().toString().padStart(2, '0');
    const minutes = date.getMinutes().toString().padStart(2, '0');
    return `${hours}:${minutes}`;
  }

  async sendMessage(): Promise<void> {
    const text = this.inputText.trim();
    if (!text || this.isLoading) return;

    // æ·»åŠ ç”¨æˆ·æ¶ˆæ¯
    this.messages.push({
      role: 'user',
      content: text,
      time: Date.now()
    });
    this.inputText = '';
    this.isLoading = true;

    // æ›´æ–°èŠå¤©å†å²
    this.chatHistory.push({ role: 'user', content: text });

    // æ»šåŠ¨åˆ°åº•éƒ¨
    setTimeout(() => {
      this.scroller.scrollEdge(Edge.Bottom);
    }, 100);

    // è°ƒç”¨AI
    const response = await aiService.chatLearn(this.courseTitle, text, this.chatHistory);

    this.isLoading = false;

    if (response.success) {
      // æ·»åŠ AIå›å¤
      this.messages.push({
        role: 'assistant',
        content: response.content,
        time: Date.now()
      });
      this.chatHistory.push({ role: 'assistant', content: response.content });
    } else {
      // æ˜¾ç¤ºé”™è¯¯
      this.messages.push({
        role: 'assistant',
        content: 'æŠ±æ­‰ï¼Œå‘ç”Ÿäº†é”™è¯¯ï¼š' + (response.error || 'æœªçŸ¥é”™è¯¯'),
        time: Date.now()
      });
    }

    // æ»šåŠ¨åˆ°åº•éƒ¨
    setTimeout(() => {
      this.scroller.scrollEdge(Edge.Bottom);
    }, 100);
  }
}
