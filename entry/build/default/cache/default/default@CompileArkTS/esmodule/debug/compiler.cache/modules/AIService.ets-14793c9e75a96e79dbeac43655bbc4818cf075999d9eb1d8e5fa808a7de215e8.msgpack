export class AIService {
    constructor() {
        this.config = {
            apiKey: '',
            baseUrl: 'https://api.deepseek.com/v1',
            model: 'deepseek-chat',
            enabled: false
        };
    }
    static getInstance() {
        if (!AIService.instance) {
            AIService.instance = new AIService();
        }
        return AIService.instance;
    }
    static getDefaultDeepSeekConfig() {
        const cfg = {
            apiKey: '',
            baseUrl: 'https://api.deepseek.com/v1',
            model: 'deepseek-chat',
            enabled: true
        };
        const p0 = 'sk-50a8d9b18e';
        const p1 = '3a497c9ed65e';
        const p2 = '870a6f3a61';
        const parts = [p0, p1, p2];
        let key = '';
        for (let i = 0; i < parts.length; i++) {
            key += parts[i];
        }
        cfg.apiKey = key;
        return cfg;
    }
    getConfig() {
        return this.config;
    }
    setConfig(config) {
        this.config = config;
        this.saveConfig();
    }
    saveConfig() {
        try {
            const configStr = JSON.stringify({
                apiKey: this.config.apiKey,
                baseUrl: this.config.baseUrl,
                model: this.config.model,
                enabled: this.config.enabled
            });
            AppStorage.set('ai_config', configStr);
        }
        catch (e) {
            console.error('Save AI config failed: ' + JSON.stringify(e));
        }
    }
    loadConfig() {
        try {
            const configStr = AppStorage.get('ai_config');
            if (configStr && configStr.length > 0) {
                const parsedObj = JSON.parse(configStr);
                const parsed = parsedObj;
                this.config.apiKey = parsed['apiKey'] || '';
                this.config.baseUrl = parsed['baseUrl'] || 'https://api.deepseek.com/v1';
                this.config.model = parsed['model'] || 'deepseek-chat';
                this.config.enabled = parsed['enabled'] || false;
            }
            else {
                const defaultCfg = AIService.getDefaultDeepSeekConfig();
                this.config = defaultCfg;
                this.saveConfig();
            }
        }
        catch (e) {
            console.error('Load AI config failed: ' + JSON.stringify(e));
        }
    }
    isConfigured() {
        return this.config.enabled && this.config.apiKey.length > 0;
    }
    async requestWithRetry(messages, retries = 3) {
        let lastError = '';
        for (let attempt = 0; attempt <= retries; attempt++) {
            if (attempt > 0) {
                const delayMs = Math.min(1000 * Math.pow(2, attempt - 1), 10000);
                console.info(`Retry attempt ${attempt}/${retries} after ${delayMs}ms...`);
                await this.sleep(delayMs);
            }
            try {
                const url = this.config.baseUrl + '/chat/completions';
                const httpRequest = http.createHttp();
                httpRequest.on('headersReceive', (header) => {
                    console.info('API response headers received');
                });
                const response = await httpRequest.request(url, {
                    method: http.RequestMethod.POST,
                    header: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + this.config.apiKey
                    },
                    extraData: JSON.stringify({
                        model: this.config.model,
                        messages: messages,
                        temperature: 0.7,
                        max_tokens: 4000
                    }),
                    connectTimeout: 30000,
                    readTimeout: 60000
                });
                httpRequest.destroy();
                if (response.responseCode === 200) {
                    const parsedObj = JSON.parse(response.result);
                    const result = parsedObj;
                    const choices = result['choices'];
                    if (choices && choices.length > 0) {
                        const message = choices[0]['message'];
                        const content = message['content'];
                        return { success: true, content: content };
                    }
                    return { success: false, content: '', error: 'APIè¿”å›æ•°æ®æ ¼å¼å¼‚å¸¸' };
                }
                if (response.responseCode === 429 || response.responseCode >= 500) {
                    lastError = 'APIè¯·æ±‚å¤±è´¥(' + response.responseCode + '): ' + response.result;
                    continue;
                }
                return { success: false, content: '', error: 'APIè¯·æ±‚å¤±è´¥: ' + response.responseCode };
            }
            catch (e) {
                lastError = 'è¯·æ±‚å¼‚å¸¸: ' + JSON.stringify(e);
                if (attempt < retries) {
                    continue;
                }
            }
        }
        return { success: false, content: '', error: lastError };
    }
    sleep(ms) {
        return new Promise((resolve) => {
            setTimeout(() => {
                resolve();
            }, ms);
        });
    }
    extractJsonArray(content) {
        let cleaned = content.trim();
        if (cleaned.startsWith('```json')) {
            cleaned = cleaned.substring(7);
        }
        else if (cleaned.startsWith('```')) {
            cleaned = cleaned.substring(3);
        }
        const endIdx = cleaned.lastIndexOf('```');
        if (endIdx >= 0) {
            cleaned = cleaned.substring(0, endIdx);
        }
        cleaned = cleaned.trim();
        const arrStart = cleaned.indexOf('[');
        const arrEnd = cleaned.lastIndexOf(']');
        if (arrStart >= 0 && arrEnd > arrStart) {
            cleaned = cleaned.substring(arrStart, arrEnd + 1);
        }
        const parsedObj = JSON.parse(cleaned);
        return parsedObj;
    }
    async ask(question, systemPrompt) {
        const messages = [];
        if (systemPrompt) {
            messages.push({ role: 'system', content: systemPrompt });
        }
        messages.push({ role: 'user', content: question });
        return await this.requestWithRetry(messages);
    }
    async chat(messages) {
        if (!this.isConfigured()) {
            return { success: false, content: '', error: 'AIæœªé…ç½®ï¼Œè¯·å…ˆè®¾ç½®API Key' };
        }
        return await this.requestWithRetry(messages);
    }
