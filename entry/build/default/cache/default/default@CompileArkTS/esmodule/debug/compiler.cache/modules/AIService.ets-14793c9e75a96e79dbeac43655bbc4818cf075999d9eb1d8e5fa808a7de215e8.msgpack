    const response = await this.ask(
      `è¯·ä¸ºå­¦ä¹ ä¸»é¢˜"${topic}"ç”ŸæˆçŸ¥è¯†å›¾è°±ã€‚è¦æ±‚è¦†ç›–è¯¥ä¸»é¢˜çš„æ ¸å¿ƒæ¦‚å¿µæ¡†æ¶ï¼ŒåŒ…å«å±‚çº§å…³ç³»å’Œæ¦‚å¿µé—´çš„é€»è¾‘å…³è”ã€‚`,
