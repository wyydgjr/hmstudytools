  MEMORY = 'è®°å¿†',
  UNDERSTAND = 'ç†è§£',
  APPLY = 'åº”ç”¨',
  ANALYZE = 'åˆ†æ',
  EVALUATE = 'è¯„ä»·',
  CREATE = 'åˆ›é€ '
}

export class QuestionOption {
  label: string = '';
  content: string = '';
  isCorrect: boolean = false;
}

export class Question {
  id: string = '';
  courseId: string = '';
  bloomLevel: BloomLevel = BloomLevel.MEMORY;
  questionText: string = '';
  options: QuestionOption[] = [];
  explanation: string = '';
  difficulty: number = 1;
}

export class AnswerRecord {
  questionId: string = '';
  courseId: string = '';
  selectedLabel: string = '';
  isCorrect: boolean = false;
  timestamp: number = 0;
  timeSpent: number = 0;
}

export class EvaluationReport {
  courseId: string = '';
  courseTitle: string = '';
  totalQuestions: number = 0;
  correctCount: number = 0;
  accuracy: number = 0;
  levelScores: Map<BloomLevel, number> = new Map();
  weakPoints: string[] = [];
  strongPoints: string[] = [];
  suggestions: string[] = [];
  dialogueRecords: AnswerRecord[] = [];
  completedAt: number = 0;

  getLevelScore(level: BloomLevel): number {
    return this.levelScores.get(level) ?? 0;
  }
}

export class QuestionBank {
  static generateQuestions(courseId: string, topic: string): Question[] {
    const levels = [
      BloomLevel.MEMORY, BloomLevel.UNDERSTAND, BloomLevel.APPLY,
      BloomLevel.ANALYZE, BloomLevel.EVALUATE, BloomLevel.CREATE
    ];
    const questions: Question[] = [];

    levels.forEach((level, idx) => {
      const q = QuestionBank.makeQuestion(courseId, topic, level, idx);
      if (q) questions.push(q);
    });
    return questions;
  }

  static makeQuestion(courseId: string, topic: string, level: BloomLevel, idx: number): Question {
    const q = new Question();
    q.id = `q_${courseId}_${idx}`;
    q.courseId = courseId;
    q.bloomLevel = level;
    q.difficulty = idx + 1;

    switch (level) {
      case BloomLevel.MEMORY:
        q.questionText = `å…³äºã€Œ${topic}ã€ï¼Œä»¥ä¸‹å“ªä¸ªæ˜¯æ ¸å¿ƒæ¦‚å¿µçš„æ­£ç¡®å®šä¹‰ï¼Ÿ`;
        q.options = [
          { label: 'A', content: `${topic}æ˜¯æŒ‡å¯¹ç›¸å…³é¢†åŸŸçŸ¥è¯†ä½“ç³»è¿›è¡Œç³»ç»ŸåŒ–ç»„ç»‡å’Œç»“æ„åŒ–è¡¨è¾¾çš„æ–¹æ³•è®º`, isCorrect: true },
          { label: 'B', content: `${topic}æ˜¯æŒ‡éšæœºè·å–ä¿¡æ¯å¹¶ç®€å•å †ç Œçš„è¿‡ç¨‹`, isCorrect: false },
          { label: 'C', content: `${topic}æ˜¯æŒ‡å®Œå…¨ä¾èµ–ä»–äººç»éªŒè€Œä¸åŠ æ€è€ƒçš„å­¦ä¹ æ–¹å¼`, isCorrect: false },
          { label: 'D', content: `${topic}æ˜¯æŒ‡åªå…³æ³¨ç†è®ºè€Œå¿½è§†å®è·µåº”ç”¨çš„ç ”ç©¶æ–¹æ³•`, isCorrect: false },
        ];
        q.explanation = `${topic}çš„æ ¸å¿ƒåœ¨äºç³»ç»ŸåŒ–ç»„ç»‡å’Œç»“æ„åŒ–è¡¨è¾¾ï¼Œå½¢æˆå¯å¤ç”¨çš„çŸ¥è¯†ä½“ç³»ã€‚`;
        break;
      case BloomLevel.UNDERSTAND:
        q.questionText = `è¯·ç”¨è‡ªå·±çš„è¯­è¨€ç†è§£ï¼šä¸ºä»€ä¹ˆã€Œ${topic}ã€ä¸­çš„æ ¸å¿ƒæ¦‚å¿µæ˜¯ç›¸äº’å…³è”çš„ï¼Ÿ`;
        q.options = [
          { label: 'A', content: 'å› ä¸ºå®ƒä»¬å…±åŒæ„æˆäº†ä¸€ä¸ªæœ‰æœºçš„çŸ¥è¯†ç”Ÿæ€ç³»ç»Ÿï¼Œæ¯ä¸ªæ¦‚å¿µéƒ½ä¾èµ–äºå…¶ä»–æ¦‚å¿µè€Œå­˜åœ¨', isCorrect: true },
          { label: 'B', content: 'å®ƒä»¬ä¹‹é—´æ²¡æœ‰å®è´¨å…³è”ï¼Œåªæ˜¯è¢«å¼ºè¡Œå½’ç±»åœ¨ä¸€èµ·', isCorrect: false },
          { label: 'C', content: 'å…³è”æ€§ä»…å­˜åœ¨äºç†è®ºå±‚é¢ï¼Œå®è·µä¸­æ²¡æœ‰ä½“ç°', isCorrect: false },
          { label: 'D', content: 'åªæœ‰å°‘æ•°æ ¸å¿ƒæ¦‚å¿µæœ‰å…³è”ï¼Œå…¶ä»–éƒ½æ˜¯ç‹¬ç«‹çš„', isCorrect: false },
        ];
        q.explanation = `${topic}ä¸­çš„æ¦‚å¿µç›¸äº’ä¾å­˜ã€ç›¸äº’æ”¯æ’‘ï¼Œå½¢æˆä¸€ä¸ªå®Œæ•´çš„çŸ¥è¯†ç”Ÿæ€ç³»ç»Ÿã€‚`;
        break;
      case BloomLevel.APPLY:
        q.questionText = `è¯·è¿ç”¨ã€Œ${topic}ã€ä¸­çš„æ–¹æ³•è®ºï¼Œè§£å†³ä»¥ä¸‹åœºæ™¯é—®é¢˜ï¼š\nä½ æ­£åœ¨å­¦ä¹ ä¸€ä¸ªå…¨æ–°çš„é¢†åŸŸï¼Œå¦‚ä½•åº”ç”¨ä¸‰é—®å­¦ä¹ æ³•åˆ¶å®šå­¦ä¹ è®¡åˆ’ï¼Ÿ`;
        q.options = [
          { label: 'A', content: 'å…ˆé—®æ ¸å¿ƒå¿ƒæ™ºæ¨¡å‹å»ºç«‹æ¡†æ¶ï¼Œå†é—®å­¦æœ¯åˆ†æ­§æ·±å…¥ç†è§£ï¼Œæœ€åé€šè¿‡æµ‹è¯„éªŒè¯å­¦ä¹ æ•ˆæœ', isCorrect: true },
          { label: 'B', content: 'åªå…³æ³¨ç¬¬ä¸‰é—®çš„æµ‹è¯„ç»“æœï¼Œå¿½è§†å‰ä¸¤ä¸ªæ­¥éª¤', isCorrect: false },
          { label: 'C', content: 'è·³è¿‡ç†è§£ç›´æ¥èƒŒè¯µæ‰€æœ‰å†…å®¹', isCorrect: false },
          { label: 'D', content: 'åªä¸“æ³¨äºç¬¬ä¸€é—®ï¼Œå¿½ç•¥åç»­æ·±å…¥', isCorrect: false },
        ];
        q.explanation = 'ä¸‰é—®å­¦ä¹ æ³•çš„æ­£ç¡®åº”ç”¨é¡ºåºæ˜¯ï¼šå¿ƒæ™ºæ¨¡å‹ï¼ˆæ¡†æ¶ï¼‰â†’ å­¦æœ¯åˆ†æ­§ï¼ˆæ·±å…¥ï¼‰â†’ æ·±åº¦æµ‹è¯„ï¼ˆéªŒè¯ï¼‰ã€‚';
        break;
      case BloomLevel.ANALYZE:
        q.questionText = `åˆ†æåœ¨ã€Œ${topic}ã€å­¦ä¹ è¿‡ç¨‹ä¸­ï¼Œä¸åŒæ•™å­¦æ–¹æ³•çš„ä¼˜åŠ£ã€‚ä»¥ä¸‹å“ªä¸ªåˆ†ææœ€å‡†ç¡®ï¼Ÿ`;
        q.options = [
          { label: 'A', content: 'ä¸»åŠ¨æ¢ç©¶å¼å­¦ä¹ ä¼˜äºè¢«åŠ¨æ¥æ”¶å¼å­¦ä¹ ï¼Œå› ä¸ºå‰è€…èƒ½ä¿ƒè¿›æ·±åº¦è®¤çŸ¥åŠ å·¥å’ŒçŸ¥è¯†è¿ç§»', isCorrect: true },
          { label: 'B', content: 'æ‰€æœ‰æ•™å­¦æ–¹æ³•çš„æ•ˆæœéƒ½ä¸€æ ·ï¼Œå…³é”®æ˜¯å­¦ä¹ æ—¶é—´é•¿çŸ­', isCorrect: false },
          { label: 'C', content: 'è¢«åŠ¨æ¥æ”¶å¼å­¦ä¹ æ•ˆç‡æ›´é«˜ï¼Œå› ä¸ºå¯ä»¥å¿«é€Ÿè·å–å¤§é‡ä¿¡æ¯', isCorrect: false },
          { label: 'D', content: 'æ•™å­¦æ–¹æ³•çš„æ•ˆæœå–å†³äºè€å¸ˆçš„æ°´å¹³è€Œéæ–¹æ³•æœ¬èº«', isCorrect: false },
        ];
        q.explanation = 'ä¸»åŠ¨æ¢ç©¶å¼å­¦ä¹ é€šè¿‡æ·±åº¦è®¤çŸ¥åŠ å·¥ï¼Œä¿ƒè¿›ç†è§£ã€è®°å¿†å’ŒçŸ¥è¯†è¿ç§»ï¼Œæ•ˆæœæ˜¾è‘—ä¼˜äºè¢«åŠ¨æ¥æ”¶ã€‚';
        break;
      case BloomLevel.EVALUATE:
        q.questionText = `è¯·è¯„ä»·ä»¥ä¸‹å­¦ä¹ ç­–ç•¥å¯¹ã€Œ${topic}ã€çš„æœ‰æ•ˆæ€§ï¼š\n"æ¯å¤©å­¦ä¹ 8å°æ—¶ï¼Œè¿ç»­ä¸€å‘¨ä¸“æ”»ä¸€ä¸ªä¸»é¢˜" vs "æ¯å¤©å­¦ä¹ 2å°æ—¶ï¼ŒæŒç»­ä¸€ä¸ªæœˆ"ã€‚å“ªç§ç­–ç•¥æ›´ä¼˜ï¼Ÿ`;
        q.options = [
          { label: 'A', content: 'åˆ†æ•£å­¦ä¹ ï¼ˆé—´éš”æ•ˆåº”ï¼‰æ›´ä¼˜ï¼šæ¯å¤©2å°æ—¶æŒç»­ä¸€ä¸ªæœˆï¼Œåˆ©ç”¨é—´éš”æ•ˆåº”æå‡é•¿æœŸè®°å¿† retention', isCorrect: true },
          { label: 'B', content: 'é›†ä¸­å­¦ä¹ æ›´ä¼˜ï¼šè¿ç»­é«˜å¼ºåº¦å­¦ä¹ å¯ä»¥åœ¨çŸ­æ—¶é—´å†…æŒæ¡å¤§é‡å†…å®¹', isCorrect: false },
          { label: 'C', content: 'ä¸¤ç§ç­–ç•¥æ•ˆæœç›¸åŒï¼Œå–å†³äºä¸ªäººåå¥½', isCorrect: false },
          { label: 'D', content: 'åº”è¯¥æ›´æç«¯ï¼šæ¯å¤©å­¦ä¹ 16å°æ—¶è¿ç»­3å¤©', isCorrect: false },
        ];
        q.explanation = 'è®¤çŸ¥å¿ƒç†å­¦ç ”ç©¶è¡¨æ˜ï¼Œé—´éš”å­¦ä¹ ï¼ˆåˆ†æ•£ç»ƒä¹ ï¼‰èƒ½æ˜¾è‘—æå‡é•¿æœŸè®°å¿†æ•ˆæœï¼Œä¼˜äºé›†ä¸­å¡«é¸­å¼å­¦ä¹ ã€‚';
        break;
      case BloomLevel.CREATE:
        q.questionText = `åŸºäºã€Œ${topic}ã€çš„å­¦ä¹ å¿ƒå¾—ï¼Œè¯·è®¾è®¡ä¸€ä¸ªåˆ›æ–°çš„å­¦ä¹ æ–¹æ¡ˆï¼Œå¸®åŠ©åˆå­¦è€…é«˜æ•ˆå…¥é—¨ã€‚`;
        q.options = [
          { label: 'A', content: 'è®¾è®¡"ä¸‰é˜¶ä¹æ­¥"å­¦ä¹ æ³•ï¼šç¬¬ä¸€é˜¶æ®µå»ºç«‹å¿ƒæ™ºåœ°å›¾ï¼ˆ3æ­¥ï¼‰ï¼Œç¬¬äºŒé˜¶æ®µåŒæ­¥å®è·µéªŒè¯ï¼ˆ3æ­¥ï¼‰ï¼Œç¬¬ä¸‰é˜¶æ®µçŸ¥è¯†åˆ›æ–°è¾“å‡ºï¼ˆ3æ­¥ï¼‰', isCorrect: true },
          { label: 'B', content: 'éšä¾¿çœ‹çœ‹è§†é¢‘å’Œæ–‡ç« å°±è¡Œ', isCorrect: false },
          { label: 'C', content: 'åªåšé¢˜ç›®ä¸å­¦ç†è®º', isCorrect: false },
          { label: 'D', content: 'è®©åˆ«äººæ›¿å­¦ç„¶åè½¬è¿°', isCorrect: false },
        ];
        q.explanation = 'ä¼˜ç§€çš„å­¦ä¹ æ–¹æ¡ˆåº”è¯¥åŒ…å«ï¼šçŸ¥è¯†æ¡†æ¶å»ºç«‹ã€å®è·µéªŒè¯ã€åˆ›æ–°è¾“å‡ºä¸‰ä¸ªå®Œæ•´é˜¶æ®µï¼Œå½¢æˆå­¦ä¹ é—­ç¯ã€‚';
        break;
    }
    return q;
  }
}
