export class QuestionOption {
    constructor() {
        this.label = '';
        this.content = '';
        this.isCorrect = false;
    }
}
export class Question {
    constructor() {
        this.id = '';
        this.courseId = '';
        this.bloomLevel = BloomLevel.MEMORY;
        this.questionText = '';
        this.options = [];
        this.explanation = '';
        this.difficulty = 1;
    }
}
export class AnswerRecord {
    constructor() {
        this.questionId = '';
        this.courseId = '';
        this.selectedLabel = '';
        this.isCorrect = false;
        this.timestamp = 0;
        this.timeSpent = 0;
    }
}
export class EvaluationReport {
    constructor() {
        this.courseId = '';
        this.courseTitle = '';
        this.totalQuestions = 0;
        this.correctCount = 0;
        this.accuracy = 0;
        this.levelScores = new Map();
        this.weakPoints = [];
        this.strongPoints = [];
        this.suggestions = [];
        this.dialogueRecords = [];
        this.completedAt = 0;
    }
    getLevelScore(level) {
        return this.levelScores.get(level) ?? 0;
    }
}
