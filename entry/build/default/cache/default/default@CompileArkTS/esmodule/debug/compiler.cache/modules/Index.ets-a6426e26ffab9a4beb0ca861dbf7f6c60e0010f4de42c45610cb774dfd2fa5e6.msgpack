        .margin({ top: 20 })

      Text('è¾“å…¥ä½ æƒ³å­¦ä¹ çš„ä»»ä½•è¯¾ç¨‹æˆ–é—®é¢˜\nAIå°†ä¸ºä½ ç”Ÿæˆä¸“å±žä¸‰é—®å­¦ä¹ è¯¾ç¨‹')
        .fontSize(14)
        .fontColor(Constants.COLOR_TEXT_SECONDARY)
        .textAlign(TextAlign.Center)
        .margin({ top: 12 })
        .lineHeight(22)

      this.buildQuickStart()

      Text('ä¸‰é—®å­¦ä¹ æ³•ä¸‰æ­¥èµ°')
        .fontSize(13)
        .fontWeight(FontWeight.Bold)
        .fontColor(Constants.COLOR_TEXT)
        .margin({ top: 32 })

      Row() {
        this.buildStepCard('Q1', 'å¿ƒæ™ºæ¨¡åž‹', 'å»ºç«‹çŸ¥è¯†æ¡†æž¶', Constants.COLOR_PRIMARY)
        this.buildStepCard('Q2', 'å­¦æœ¯åˆ†æ­§', 'åŸ¹å…»æ‰¹åˆ¤æ€ç»´', Constants.COLOR_ACCENT_PURPLE)
        this.buildStepCard('Q3', 'æ·±åº¦æµ‹è¯„', 'æ£€éªŒå­¦ä¹ æ•ˆæžœ', Constants.COLOR_ACCENT_GREEN)
      }
      .width('100%')
      .margin({ top: 12 })
      .justifyContent(FlexAlign.SpaceBetween)
    }
    .width('100%')
  }

  @Builder buildQuickStart() {
    Column() {
      Text('å¿«é€Ÿå¼€å§‹ç¤ºä¾‹')
        .fontSize(12)
        .fontColor(Constants.COLOR_TEXT_SECONDARY)
        .margin({ top: 20, bottom: 8 })

      Flex({ wrap: FlexWrap.Wrap, justifyContent: FlexAlign.Center }) {
        ForEach(['é¸¿è’™ArkTSå¼€å‘', 'æœºå™¨å­¦ä¹ å…¥é—¨', 'ç»æµŽå­¦åŽŸç†', 'Pythonç¼–ç¨‹', 'é‡å­è®¡ç®—', 'è®¾è®¡æ¨¡å¼'], (topic: string) => {
          Text(topic)
            .fontSize(12)
            .fontColor(Constants.COLOR_PRIMARY)
            .backgroundColor(0x0F0078D7)
            .padding({ left: 12, right: 12, top: 6, bottom: 6 })
            .borderRadius(16)
            .margin(4)
            .onClick(() => {
              this.searchText = topic;
              this.createCourse();
            })
        }, (topic: string) => topic)
      }
      .width('100%')
    }
  }

  @Builder buildStepCard(q: string, title: string, desc: string, color: ResourceColor) {
    Column() {
      Stack() {
        Circle()
          .width(36)
          .height(36)
          .fill(color)
        Text(q).fontSize(14).fontColor('#FFFFFF').fontWeight(FontWeight.Bold)
      }
      .width(36)
      .height(36)
      Text(title)
        .fontSize(12)
        .fontWeight(FontWeight.Bold)
        .fontColor(Constants.COLOR_TEXT)
        .margin({ top: 6 })
      Text(desc)
        .fontSize(10)
        .fontColor(Constants.COLOR_TEXT_SECONDARY)
    }
    .padding(12)
    .backgroundColor(Constants.COLOR_CARD)
    .borderRadius(12)
    .shadow({ radius: 4, offsetY: 1, color: 0x0A000000 })
  }

  @Builder buildCourseList() {
    Column() {
      Text('æˆ‘çš„è¯¾ç¨‹')
        .fontSize(18)
        .fontWeight(FontWeight.Bold)
        .fontColor(Constants.COLOR_TEXT)
        .width('100%')
        .margin({ top: 4, bottom: 8 })

      List() {
        ForEach(this.courses, (course: Course) => {
          ListItem() {
            CourseCard({
              course: course,
              onCardClick: () => {
                course.lastAccessedAt = Date.now();
                StorageUtil.saveData();
                router.pushUrl({
                  url: 'pages/LearningSpace',
                  params: { courseId: course.id, courseTitle: course.title }
                });
              }
            })
            .transition(
              TransitionEffect.translate({ x: 60, y: 0 })
                .combine(TransitionEffect.opacity(0))
            )
          }
          .margin({ bottom: 12 })
          .transition(
            TransitionEffect.translate({ x: 60, y: 0 })
              .combine(TransitionEffect.opacity(0))
          )
        }, (course: Course) => course.id)
      }
      .width('100%')
    }
  }

  updateSuggestions(val: string): void {
    if (val.trim().length === 0) {
      this.suggestions = [];
      this.showSuggestions = false;
      return;
    }
    this.suggestions = this.courses
      .map(c => c.title)
      .filter(t => t.toLowerCase().includes(val.toLowerCase()))
      .slice(0, 5);
    this.showSuggestions = this.suggestions.length > 0;
  }

  getGreeting(): string {
    const hour = new Date().getHours();
    let timeMsg = '';
    let emoji = '';
    if (hour < 6) { timeMsg = 'å¤œæ·±äº†'; emoji = 'ðŸŒ™'; }
    else if (hour < 9) { timeMsg = 'æ—©ä¸Šå¥½'; emoji = 'ðŸŒ…'; }
    else if (hour < 12) { timeMsg = 'ä¸Šåˆå¥½'; emoji = 'â˜€ï¸'; }
    else if (hour < 14) { timeMsg = 'ä¸­åˆå¥½'; emoji = 'ðŸŒž'; }
    else if (hour < 18) { timeMsg = 'ä¸‹åˆå¥½'; emoji = 'ðŸ“š'; }
    else if (hour < 22) { timeMsg = 'æ™šä¸Šå¥½'; emoji = 'ðŸŒ†'; }
    else { timeMsg = 'å¤œæ·±äº†'; emoji = 'ðŸŒ™'; }
    return `${timeMsg}ï¼ä»Šå¤©ä¹Ÿè¦åŠ æ²¹å“¦ ${emoji}`;
  }

  createCourse(): void {
    const text = this.searchText.trim();
    if (!text) return;

    const existing = this.courses.find(c => c.title === text);
    if (existing) {
      existing.lastAccessedAt = Date.now();
      StorageUtil.saveData();
      router.pushUrl({
        url: 'pages/LearningSpace',
        params: { courseId: existing.id, courseTitle: existing.title }
      });
      return;
    }

    const course = Course.createFromTopic(text);
    globalData.addCourse(course);
    this.courses = globalData.getCourses();
    this.searchText = '';
    this.showSuggestions = false;

    const newlyEarned = globalData.checkAllAchievements();
    if (newlyEarned.length > 0) {
      this.newAchievements = newlyEarned;
      const names = newlyEarned.map(id => {
        const infos = globalData.getAllAchievementInfos();
        const info = infos.find(i => i.id === id);
        return info ? info.name : id;
      });
      this.celebrationMsg = 'ðŸŽ‰ èŽ·å¾—æˆå°±: ' + names.join(', ');
      this.showCelebration = true;
      setTimeout(() => {
        this.showCelebration = false;
      }, 4000);
    }
    this.achievementInfos = globalData.getAllAchievementInfos();
    StorageUtil.saveData();

    router.pushUrl({
      url: 'pages/LearningSpace',
      params: { courseId: course.id, courseTitle: course.title }
    });
  }
}
